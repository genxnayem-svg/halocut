  <ExtensionList>
    <!-- HaloCut: the one panel in Window → Extensions; every tool for the app inside it. -->
    <Extension Id="com.samistudio.halocut.hub" Version="0.1.0" />
    <!-- Hidden bridge: starts with the app and runs Tool wheel commands. -->
    <Extension Id="com.samistudio.halocut.bg" Version="0.1.1" />
    <!-- HaloCut Studio: the visible panel (Silence, and more to come). -->
    <Extension Id="com.samistudio.halocut.bridge" Version="0.1.1" />
    <!-- HaloCut Motion: start look, end look, the eased move as keyframes. -->
    <Extension Id="com.samistudio.halocut.motion" Version="0.1.0" />
    <!-- HaloCut Markers: chapters, files and cuts from sequence markers. -->
    <Extension Id="com.samistudio.halocut.markers" Version="0.1.0" />
    <!-- HaloCut Beat: tempo, beat markers, cuts and pulses from the music. -->
    <Extension Id="com.samistudio.halocut.beat" Version="0.1.0" />
    <!-- HaloCut Bins: tidy the Project panel. -->
    <Extension Id="com.samistudio.halocut.bins" Version="0.1.0" />
    <!-- HaloCut Transitions: keyframed transitions on cuts. -->
    <Extension Id="com.samistudio.halocut.trans" Version="0.1.0" />
    <!-- HaloCut Split: split screens and reframes built as a new sequence. -->
    <Extension Id="com.samistudio.halocut.split" Version="0.1.0" />
    <!-- HaloCut Zoom: zooms, frame, focus, callouts and cards for screen recordings. -->
    <Extension Id="com.samistudio.halocut.zoom" Version="0.1.0" />
    <!-- HaloCut Grade: click-to-grade with scopes, onto Lumetri Color. -->
    <Extension Id="com.samistudio.halocut.grade" Version="0.1.0" />
    <!-- HaloCut Caption Styles: animated, timed captions as pictures on the video. -->
    <Extension Id="com.samistudio.halocut.styles" Version="0.1.0" />
    <!-- HaloCut Retakes: fillers, stutters, false starts and mumbles, cut in sync. -->
    <Extension Id="com.samistudio.halocut.retakes" Version="0.1.0" />
    <!-- HaloCut Toolbar: one-click jobs, search, pins on 1–9, QC check. -->
    <Extension Id="com.samistudio.halocut.toolbar" Version="0.1.0" />
    <!-- HaloCut Podcast: cameras follow the voices, music dips under them. -->
    <Extension Id="com.samistudio.halocut.podcast" Version="0.1.0" />
    <!-- HaloCut Kit (After Effects): expression rigs and layer tools. -->
    <Extension Id="com.samistudio.halocut.kit" Version="0.1.0" />
    <!-- HaloCut Resize (After Effects): one comp into other sizes. -->
    <Extension Id="com.samistudio.halocut.resize" Version="0.1.0" />
    <!-- HaloCut Type (After Effects): kinetic type from text animators. -->
    <Extension Id="com.samistudio.halocut.type" Version="0.1.0" />
    <!-- HaloCut Flow (After Effects): transitions between layers. -->
    <Extension Id="com.samistudio.halocut.flow" Version="0.1.0" />
    <!-- HaloCut Vector (After Effects): SVG into native shape layers. -->
    <Extension Id="com.samistudio.halocut.vector" Version="0.1.0" />
    <!-- HaloCut Accents (After Effects): motion accents as animated shape layers. -->
    <Extension Id="com.samistudio.halocut.accent" Version="0.1.0" />
    <!-- HaloCut Command (Premiere Pro): search and run anything from the keyboard, combos, shortcuts. -->
    <Extension Id="com.samistudio.halocut.command" Version="0.1.0" />
  </ExtensionList>
