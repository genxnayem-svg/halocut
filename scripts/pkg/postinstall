#!/bin/sh
# HaloCut installer: put the Adobe panels in place for the person installing, let Premiere Pro and
# After Effects load them, and start HaloCut. Runs as root; everything personal is done as that person.
# © 2026 Imtayz Nayem

APP="/Applications/HaloCut.app"
SRC="$APP/Contents/Resources/extension"
ID="com.samistudio.halocut"

USER_NAME=$(/usr/bin/stat -f%Su /dev/console)
if [ -z "$USER_NAME" ] || [ "$USER_NAME" = "root" ] || [ "$USER_NAME" = "loginwindow" ]; then exit 0; fi # nobody logged in
USER_HOME=$(/usr/bin/dscl . -read "/Users/$USER_NAME" NFSHomeDirectory | /usr/bin/awk '{print $2}')
USER_ID=$(/usr/bin/id -u "$USER_NAME")
as_user() { /bin/launchctl asuser "$USER_ID" /usr/bin/sudo -u "$USER_NAME" "$@"; }

# The panels: Premiere Pro and After Effects look in the person's own CEP extensions folder.
DEST_DIR="$USER_HOME/Library/Application Support/Adobe/CEP/extensions"
DEST="$DEST_DIR/$ID"
if [ -L "$DEST" ]; then
  : # a developer link to the source folder: leave it, so work in progress keeps showing
elif [ -d "$SRC" ]; then
  as_user /bin/mkdir -p "$DEST_DIR"
  /bin/rm -rf "$DEST"
  /usr/bin/ditto "$SRC" "$DEST"
  /usr/sbin/chown -R "$USER_NAME" "$DEST"
fi

# HaloCut's panels aren't signed by Adobe's tool yet, so Premiere Pro and After Effects need this to load them.
for v in 9 10 11 12 13; do
  as_user /usr/bin/defaults write "com.adobe.CSXS.$v" PlayerDebugMode 1
done

# A new build is a new app to macOS: the old Accessibility / Input Monitoring entries stay switched on but no longer
# count, and macOS won't ask again while they're there. Clear HaloCut's own entries (only HaloCut's), so HaloCut asks
# macOS fresh on its first start and one switch puts it right.
# HaloCut's app id changed to com.imtayznayem.halocut (0.2.x): macOS kept refusing the old id however it was
# switched on. Clear the old id's leftovers, so only one HaloCut shows in the lists.
OLD_ID="com.samistudio.halocut"
NEW_ID="com.imtayznayem.halocut"
for svc in Accessibility ListenEvent; do
  /usr/bin/tccutil reset $svc $OLD_ID >/dev/null 2>&1
  as_user /usr/bin/tccutil reset $svc $OLD_ID >/dev/null 2>&1
done
# An ad-hoc build is a new app to macOS each time (its old switches stop counting): clear its entries so it asks fresh.
# A build signed with the certificate keeps its permission, so it is left alone.
if /usr/bin/codesign -d -r- "$APP" 2>&1 | /usr/bin/grep -q "cdhash"; then
  for svc in Accessibility ListenEvent; do
    /usr/bin/tccutil reset $svc $NEW_ID >/dev/null 2>&1
    as_user /usr/bin/tccutil reset $svc $NEW_ID >/dev/null 2>&1
  done
  for k in "$APP" "$APP/Contents/MacOS/HaloCut" "1::$APP" "1::$APP/Contents/MacOS/HaloCut" $NEW_ID 1::$NEW_ID; do
    as_user /usr/bin/defaults delete com.apple.universalaccessAuthWarning "$k" >/dev/null 2>&1
  done
fi

# Start HaloCut (it lives in the menu bar). It asks macOS for Accessibility itself when it doesn't have it.
as_user /usr/bin/open "$APP" 2>/dev/null
exit 0
